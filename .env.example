# Copy this file to `.env` and fill in real values. `.env` itself is gitignored.

# ---------------------------------------------------------------------------
# Postgres connection string (Neon: Dashboard -> your project -> Connect).
#
# IMPORTANT for serverless deploys (Vercel): use Neon's POOLED endpoint — the
# host contains "-pooler". Each serverless invocation opens its own connection,
# and the direct endpoint will exhaust Neon's connection limit under load.
#   pooled: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=verify-full
#   direct: postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=verify-full
#
# Use sslmode=verify-full (not `require`, which node-postgres warns about).
# `prisma migrate deploy` works against either endpoint.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Secret that signs session cookies (HS256). Must be >= 32 characters.
# Generate a fresh one per environment — NEVER reuse your dev secret in prod:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Credentials for the platform super-admin created by `npm run db:seed`.
# Change the password before seeding anything you'll expose publicly.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# development | test | production (defaults to development if omitted).
# In production the session cookie is set `secure`, so HTTPS is required.
NODE_ENV=development
